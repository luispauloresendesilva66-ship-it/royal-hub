# Copie para .env e preencha. NUNCA suba o .env para o Git.

# Endereço público do túnel (Cloudflare Zero Trust → Tunnels → Public hostname → http://evolution:8080)
EVOLUTION_PUBLIC_URL=https://wa.SEU-DOMINIO.com.br

# Chave mestra da Evolution (invente uma longa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
EVOLUTION_API_KEY=

# Senha do Postgres local que guarda as sessões do WhatsApp
POSTGRES_PASSWORD=

# Token do túnel (Cloudflare Zero Trust → Tunnels → seu túnel → Docker)
CLOUDFLARE_TUNNEL_TOKEN=

# Fixe a versão da imagem (confira as tags em https://hub.docker.com/r/evoapicloud/evolution-api/tags)
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.6
